(version 1)
(deny default)
(deny network*)
(allow process*)
(allow dynamic-code-generation)
(allow sysctl-read)
(allow mach-lookup)
(allow ipc-posix-shm)
(allow file-read*
  (subpath "/System")
  (subpath "/Library")
  (subpath "/bin")
  (subpath "/usr/bin")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/private/etc")
  (subpath "/private/var")
  (subpath "/dev")
  (subpath (param "NODE_ROOT"))
  (subpath (param "F3_ROOT"))
  (subpath (param "RECORDER_ROOT"))
  (subpath (param "TSX_ROOT"))
  (subpath (param "ESBUILD_ROOT"))
  (subpath (param "GET_TSCONFIG_ROOT"))
  (subpath (param "RESOLVE_PKG_MAPS_ROOT"))
  (subpath (param "BETTER_SQLITE3_ROOT"))
  (subpath (param "BINDINGS_ROOT"))
  (subpath (param "FILE_URI_TO_PATH_ROOT"))
  (subpath (param "CANDIDATE_1"))
  (subpath (param "CANDIDATE_2"))
  (subpath (param "CANDIDATE_3"))
  (subpath (param "CANDIDATE_4"))
  (subpath (param "CANDIDATE_5"))
  (subpath (param "CANDIDATE_6"))
  (literal "/usr/bin/sqlite3"))
(allow file-write* (subpath (param "RECORDER_ROOT")))
(deny file-read* (subpath (param "F1_F2_ROOT")))
(deny file-write* (subpath (param "REPO_ROOT")))
