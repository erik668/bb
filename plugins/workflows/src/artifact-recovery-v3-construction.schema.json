{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bb-artifact-review-v3-construction-c0-authority-v1",
  "title": "BB artifact review V3 construction C0 closed authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "successorSeamId",
    "bindingSynthesis",
    "contract",
    "scope",
    "identities",
    "sentinelCatalog",
    "negativeControls",
    "prebuildOracle"
  ],
  "properties": {
    "schemaVersion": {
      "const": "bb-artifact-review-v3-construction-c0-authority-v1"
    },
    "successorSeamId": {
      "const": "bb-artifact-review-v3-construction-c0:revision-1"
    },
    "bindingSynthesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "workflowName",
        "sourceByteLength",
        "sourceSha256",
        "terminalStatus",
        "decisionClass"
      ],
      "properties": {
        "runId": {
          "const": "wfr_bb6478f8-e7eb-4681-b743-66ec49cce5c6"
        },
        "workflowName": {
          "const": "artifact-review-v12-construction-admission"
        },
        "sourceByteLength": { "const": 8230 },
        "sourceSha256": { "$ref": "#/definitions/sha256" },
        "terminalStatus": { "const": "succeeded" },
        "decisionClass": { "const": "contract-preserving" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectureRevision",
        "contractId",
        "authority",
        "presentation",
        "saved",
        "bytes",
        "retention",
        "migrationIds",
        "rollout",
        "maliciousWriterAuthenticityClaim",
        "sharedHostMutation",
        "crossEnvironmentContinuation",
        "bootstrap",
        "deployment"
      ],
      "properties": {
        "architectureRevision": { "const": 2 },
        "contractId": {
          "const": "bb-artifact-review-service:revision-1"
        },
        "authority": {
          "const": "server-assigned-local-owner-over-origin-campaign-project-environment"
        },
        "presentation": { "const": "grant-and-provenance-only" },
        "saved": { "const": "committed-only" },
        "bytes": { "const": "content-addressed" },
        "retention": { "const": "append-only" },
        "migrationIds": { "const": "0..22" },
        "rollout": { "const": "dark" },
        "maliciousWriterAuthenticityClaim": { "const": false },
        "sharedHostMutation": { "const": false },
        "crossEnvironmentContinuation": { "const": false },
        "bootstrap": { "const": false },
        "deployment": { "const": false }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracleWritePaths",
        "constructionPaths",
        "ledgerPath",
        "approvalPath",
        "ledgerMustBeAbsent",
        "approvalMustBeAbsent",
        "productValueAdded"
      ],
      "properties": {
        "oracleWritePaths": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/repositoryPath" }
        },
        "constructionPaths": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/repositoryPath" }
        },
        "ledgerPath": { "$ref": "#/definitions/repositoryPath" },
        "approvalPath": { "$ref": "#/definitions/repositoryPath" },
        "ledgerMustBeAbsent": { "const": true },
        "approvalMustBeAbsent": { "const": true },
        "productValueAdded": { "const": false }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptedDesign",
        "contextPacket",
        "v8Approval",
        "v12",
        "failedLineage",
        "migrations",
        "worktreeBaseline"
      ],
      "properties": {
        "acceptedDesign": { "$ref": "#/definitions/fileIdentity" },
        "contextPacket": { "$ref": "#/definitions/fileIdentity" },
        "v8Approval": { "$ref": "#/definitions/fileIdentity" },
        "v12": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approval", "ledger", "candidateManifest"],
          "properties": {
            "approval": { "$ref": "#/definitions/fileIdentity" },
            "ledger": { "$ref": "#/definitions/fileIdentity" },
            "candidateManifest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["encoding", "byteLength", "sha256", "entries"],
              "properties": {
                "encoding": {
                  "const": "UTF-8 JSON.stringify of path.localeCompare-sorted {path,sha256} entries with no terminal newline"
                },
                "byteLength": { "const": 798 },
                "sha256": { "$ref": "#/definitions/sha256" },
                "entries": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "items": { "$ref": "#/definitions/fileIdentity" }
                }
              }
            }
          }
        },
        "failedLineage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["v9", "v10", "v11", "v6Receipt"],
          "properties": {
            "v9": { "$ref": "#/definitions/failedV9" },
            "v10": { "$ref": "#/definitions/failedProof" },
            "v11": { "$ref": "#/definitions/failedProof" },
            "v6Receipt": { "$ref": "#/definitions/unadmittedFileIdentity" }
          }
        },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "count",
            "vectorEncoding",
            "vectorByteLength",
            "vectorSha256",
            "entries"
          ],
          "properties": {
            "source": { "$ref": "#/definitions/fileIdentity" },
            "count": { "const": 23 },
            "vectorEncoding": {
              "const": "id-colon-sha256-semicolon-no-terminal"
            },
            "vectorByteLength": { "const": 1553 },
            "vectorSha256": { "$ref": "#/definitions/sha256" },
            "entries": {
              "type": "array",
              "minItems": 23,
              "maxItems": 23,
              "items": { "$ref": "#/definitions/migrationIdentity" }
            }
          }
        },
        "worktreeBaseline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "head",
            "branch",
            "dirty",
            "indexClean",
            "porcelainV1ZEntryCount",
            "porcelainV1ZSha256",
            "unrelatedManifestEncoding",
            "unrelatedFileCount",
            "unrelatedManifestByteLength",
            "unrelatedManifestSha256"
          ],
          "properties": {
            "root": { "type": "string", "minLength": 1 },
            "head": { "$ref": "#/definitions/sha1" },
            "branch": { "const": "feature/workflow-detail-ledger" },
            "dirty": { "const": true },
            "indexClean": { "const": true },
            "porcelainV1ZEntryCount": { "const": 61 },
            "porcelainV1ZSha256": { "$ref": "#/definitions/sha256" },
            "unrelatedManifestEncoding": { "type": "string", "minLength": 1 },
            "unrelatedFileCount": { "const": 73 },
            "unrelatedManifestByteLength": { "const": 12957 },
            "unrelatedManifestSha256": { "$ref": "#/definitions/sha256" }
          }
        }
      }
    },
    "sentinelCatalog": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/definitions/sentinel" }
    },
    "negativeControls": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/definitions/negativeControl" }
    },
    "prebuildOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "passed",
        "failed",
        "skipped",
        "expectedFailureClass",
        "approvalPresenceIsFailure",
        "databaseAccessAllowed",
        "productionImportsAllowed"
      ],
      "properties": {
        "selected": { "const": 15 },
        "passed": { "const": 1 },
        "failed": { "const": 14 },
        "skipped": { "const": 0 },
        "expectedFailureClass": { "const": "missing-v3-construction" },
        "approvalPresenceIsFailure": { "const": false },
        "databaseAccessAllowed": { "const": false },
        "productionImportsAllowed": { "const": false }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sha1": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\.\\.).+$"
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "$ref": "#/definitions/repositoryPath" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "unadmittedFileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "byteLength", "sha256", "admitted"],
      "properties": {
        "path": { "$ref": "#/definitions/repositoryPath" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "admitted": { "const": false }
      }
    },
    "failedV9": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "terminalVerdict",
        "approvalPresent",
        "bootstrapAllowed",
        "adoptionAllowed",
        "aliasAllowed",
        "manifestByteLength",
        "manifestSha256",
        "files"
      ],
      "properties": {
        "disposition": { "const": "failed-design-lineage-only" },
        "terminalVerdict": { "const": "blocked" },
        "approvalPresent": { "const": false },
        "bootstrapAllowed": { "const": false },
        "adoptionAllowed": { "const": false },
        "aliasAllowed": { "const": false },
        "manifestByteLength": { "const": 186 },
        "manifestSha256": { "$ref": "#/definitions/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/definitions/fileIdentity" }
        }
      }
    },
    "failedProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "terminalVerdict",
        "approvalPresent",
        "manifestByteLength",
        "manifestSha256",
        "files"
      ],
      "properties": {
        "disposition": { "const": "failed-proof-lineage-only" },
        "terminalVerdict": { "const": "blocked" },
        "approvalPresent": { "const": false },
        "manifestByteLength": { "type": "integer", "minimum": 1 },
        "manifestSha256": { "$ref": "#/definitions/sha256" },
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 5,
          "items": { "$ref": "#/definitions/fileIdentity" }
        }
      }
    },
    "migrationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "byteLength", "sha256"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 22 },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "sentinel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provenance",
        "arm",
        "path",
        "symbol",
        "requiredTokens",
        "orderedTokens",
        "killerId",
        "expectedPrebuild",
        "allowedFailure"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "provenance": {
          "enum": [
            "v12-construction-sentinel",
            "current-seam",
            "current-seam-v12-by-reference"
          ]
        },
        "arm": {
          "enum": ["fake", "production", "shared", "plugin", "independent"]
        },
        "path": { "$ref": "#/definitions/repositoryPath" },
        "symbol": { "type": "string", "minLength": 1 },
        "requiredTokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "orderedTokens": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "killerId": { "type": "string", "minLength": 1 },
        "expectedPrebuild": {
          "enum": ["present", "missing-construction"]
        },
        "allowedFailure": {
          "enum": [
            "none",
            "missing-path-or-symbol",
            "missing-symbol",
            "missing-symbol-or-order"
          ]
        }
      }
    },
    "negativeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sentinelId", "expectedReason"],
      "properties": {
        "id": {
          "enum": [
            "fallthrough-to-v2",
            "plugin-self-attestation",
            "database-before-authority-admission",
            "copied-production-fake-decision-logic",
            "missing-reopened-verification",
            "consumer-reachability"
          ]
        },
        "sentinelId": { "type": "string", "minLength": 1 },
        "expectedReason": {
          "enum": [
            "v3-fallthrough-to-v2",
            "plugin-supplied-expected-identity",
            "database-before-authority",
            "copied-adapter-decision-logic",
            "verification-without-reopen",
            "consumer-before-verification"
          ]
        }
      }
    }
  }
}
