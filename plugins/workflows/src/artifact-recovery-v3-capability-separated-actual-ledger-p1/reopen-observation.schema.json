{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bb-artifact-review-p1-reopen-observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "identity", "observer", "content"],
  "properties": {
    "version": { "const": 1 },
    "identity": { "type": "string", "pattern": "^[0-9a-f]{48}$" },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "ppid", "handleNonce"],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "ppid": { "type": "integer", "minimum": 1 },
        "handleNonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stateBytes", "stateSha256"],
      "properties": {
        "stateBytes": { "type": "integer", "minimum": 0 },
        "stateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

